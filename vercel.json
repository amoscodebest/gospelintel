{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/post",
      "destination": "/api/post"
    },
    {
      "source": "/post.html",
      "destination": "/api/post"
    }
  ],
  "headers": [
    {
      "source": "/api/post",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=86400, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
